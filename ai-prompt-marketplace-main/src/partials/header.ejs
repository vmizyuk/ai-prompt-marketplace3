<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="index.html" aria-label="AI Prompt Marketplace, home page">AI Prompt Marketplace</a>
    <nav class="main-nav" aria-label="Main">
      <ul class="main-nav__list">
        <% nav.forEach(item => { %>
        <li class="main-nav__item">
          <a class="main-nav__link" href="<%= item.href %>" data-i18n="<%= item.i18n %>"<% if (item.key === page) { %> aria-current="page"<% } %>><%= item.label %></a>
        </li>
        <% }) %>
      </ul>
    </nav>
    <a class="site-header__cart" href="cart.html" aria-label="Cart, <%= cart.length %> items">Cart (<span data-cart-count><%= cart.length %></span>)</a>
  </div>
</header>
